# ===================================================================
# Personal Portfolio - .gitignore
# Duvva Sai Vivek | AI & Data Science Student Portfolio
# ===================================================================

# Operating System Files
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes

# Linux
*~
.directory

# IDE & Code Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.sublime-project
*.sublime-workspace
.idea/
*.swp
*.swo
*.swn
*.bak
*.tmp

# Node / Web Dependencies & Caches
node_modules/
jspm_packages/
.pnp/
.pnp.js
.cache/
.parcel-cache/
dist/
build/
out/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Private Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Python Caches & Virtual Environments (if local utilities are run)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/

# AI & Editor Internal State
.gemini/
.agents/scratch/
.system_generated/
*.crdownload

# Preserve placeholder directories in git
!.gitkeep
